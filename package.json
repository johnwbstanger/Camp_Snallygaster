{
  "name": "camp-snallygaster",
  "version": "1.0.0",
  "description": "First-person cooperative horror extraction game set at a 1993 summer camp",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "node --loader tsx ./server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "three": "^r128",
    "cannon-es": "^0.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/three": "^r128",
    "@types/ws": "^8.5.7",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "tsx": "^3.14.0"
  }
}
