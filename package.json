{
  "name": "camp-snallygaster-rebuild",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke:multiplayer": "node scripts/multiplayer-smoke.mjs"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "express": "4.21.2",
    "three": "0.160.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/three": "0.160.0",
    "@types/ws": "8.5.13",
    "concurrently": "9.1.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
